# ============================================================
# Local Development Environment Variables
# ============================================================
# Do NOT place actual production secrets in this file.
# Copy this file to .env and adjust as necessary for local dev.
# ============================================================

# --- PostgreSQL ---
# The default superuser name for PostgreSQL
POSTGRES_USER=postgres
# The default superuser password (local dev only)
POSTGRES_PASSWORD=postgres
# The name of the primary database to create on startup
POSTGRES_DB=restaurant_erp
# The host port mapped to the PostgreSQL container
POSTGRES_PORT=5432

# --- Redis ---
# The host port mapped to the Redis container
REDIS_PORT=6379

# --- Prisma / Application Database ---
# Assembled from POSTGRES_* variables above.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/restaurant_erp?schema=public"
