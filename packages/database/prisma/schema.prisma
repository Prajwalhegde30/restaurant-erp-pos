generator client {
  provider = "prisma-client-js"
}

generator zod {
  provider                  = "zod-prisma-types"
  output                    = "../../types/src/generated"
  createInputTypes          = false
  createRelationValuesTypes = true
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

// --- IAM / Platform ---

enum TenantStatus {
  CREATED
  ACTIVE
  SUSPENDED
}

enum PermissionScope {
  OWN
  BRANCH
  TENANT
  ANY
}

// --- Catalog ---

enum MenuStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum MenuItemStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum ComboStatus {
  ACTIVE
  INACTIVE
}

// --- Ordering / Operational ---

enum TableStatus {
  AVAILABLE
  SEATED
  BILLED
  RESERVED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  CANCELLED
  NO_SHOW
}

enum OrderStatus {
  DRAFT
  PLACED
  IN_PREP
  READY
  SERVED
  PAID
  CLOSED
  VOIDED
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderItemStatus {
  PENDING
  IN_PREP
  READY
  SERVED
  VOIDED
}

// --- Supply Chain ---

enum SupplierStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum IngredientUnit {
  KG
  G
  L
  ML
  PIECE
  PORTION
  BOX
  PACK
}

enum StockMovementType {
  PURCHASE
  CONSUMPTION
  SPOILAGE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  RETURN
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum GoodsReceiptStatus {
  PENDING
  COMPLETED
  REJECTED
}

// --- Finance ---

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOIDED
  REFUNDED
}

enum PaymentStatus {
  INITIATED
  AUTHORIZED
  CAPTURED
  FAILED
  VOIDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE
  GIFT_CARD
  LOYALTY
  SPLIT
}

enum RefundStatus {
  PENDING
  APPROVED
  PROCESSED
  REJECTED
}

enum JournalEntryType {
  DEBIT
  CREDIT
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum DailyClosingStatus {
  PENDING
  RECONCILED
  LOCKED
}

enum ConfigurationLevel {
  GLOBAL
  TENANT
  BRANCH
  STATION
}

// ==========================================
// PLATFORM FOUNDATION MODELS
// ==========================================

model Tenant {
  id     String       @id @default(uuid())
  name   String
  status TenantStatus @default(ACTIVE)

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations — IAM
  branches               Branch[]
  users                  User[]
  roles                  Role[]
  permissions            Permission[]
  userRoles              UserRole[]
  branchAssignments      BranchAssignment[]
  // Relations — Catalog
  menus                  Menu[]
  categories             Category[]
  menuItems              MenuItem[]
  modifierGroups         ModifierGroup[]
  modifierOptions        ModifierOption[]
  menuItemModifierGroups MenuItemModifierGroup[]
  combos                 Combo[]
  comboItems             ComboItem[]
  // Relations — Operational
  diningTables           DiningTable[]
  reservations           Reservation[]
  orders                 Order[]
  orderItems             OrderItem[]
  orderMerges            OrderMerge[]
  // Relations — Supply Chain
  suppliers              Supplier[]
  ingredients            Ingredient[]
  inventoryItems         InventoryItem[]
  inventoryBatches       InventoryBatch[]
  stockMovements         StockMovement[]
  recipes                Recipe[]
  recipeIngredients      RecipeIngredient[]
  purchaseOrders         PurchaseOrder[]
  goodsReceipts          GoodsReceipt[]
  // Relations — Finance
  invoices               Invoice[]
  payments               Payment[]
  refunds                Refund[]
  ledgerAccounts         LedgerAccount[]
  journals               Journal[]
  journalEntries         JournalEntry[]
  shifts                 Shift[]
  cashDrawers            CashDrawer[]
  dailyClosings          DailyClosing[]
  // Relations — Audit
  auditLogs              AuditLog[]
  configurations         Configuration[]
  fiscalPeriods          FiscalPeriod[]
  costCenters            CostCenter[]
  supplierInvoices       SupplierInvoice[]
  Customer               Customer[]
  Membership             Membership[]
  LoyaltyLedger          LoyaltyLedger[]
  Coupon                 Coupon[]
  GiftCard               GiftCard[]
  CouponCustomerUsage    CouponCustomerUsage[]
  GiftCardTransaction    GiftCardTransaction[]
  analyticsSnapshots     AnalyticsSnapshot[]

  @@map("tenants")
}

model Branch {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  name     String

  // Configuration
  taxConfig Json?  @map("tax_config")
  timezone  String @default("UTC")
  currency  String @default("USD")

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations — IAM
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userRoles          UserRole[]
  branchAssignments  BranchAssignment[]
  // Relations — Catalog
  menuBranches       MenuBranch[]
  // Relations — Operational
  diningTables       DiningTable[]
  reservations       Reservation[]
  orders             Order[]
  // Relations — Supply Chain
  suppliers          Supplier[]
  inventoryItems     InventoryItem[]
  inventoryBatches   InventoryBatch[]
  stockMovements     StockMovement[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  invoices           Invoice[]
  costCenters        CostCenter[]
  supplierInvoices   SupplierInvoice[]
  // Relations — Finance
  shifts             Shift[]
  cashDrawers        CashDrawer[]
  dailyClosings      DailyClosing[]
  configurations     Configuration[]
  analyticsSnapshots AnalyticsSnapshot[]

  @@index([tenantId])
  @@map("branches")
}

model User {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  email     String
  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  pin       String?

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userRoles         UserRole[]
  branchAssignments BranchAssignment[]
  orders            Order[]
  reservations      Reservation[]
  shifts            Shift[]
  auditLogs         AuditLog[]

  // Note: Partial unique index (tenant_id, email) WHERE is_deleted = false enforced in migration
  @@index([tenantId])
  @@map("users")
}

model Role {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  parentId String? @map("parent_id")
  name     String

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parent      Role?        @relation("RoleHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Role[]       @relation("RoleHierarchy")
  permissions Permission[]
  userRoles   UserRole[]

  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id           String          @id @default(uuid())
  tenantId     String          @map("tenant_id")
  roleId       String          @map("role_id")
  module       String
  resource     String
  action       String
  scope        PermissionScope @default(BRANCH)
  thresholdKey String?         @map("threshold_key")
  isDeny       Boolean         @default(false) @map("is_deny")

  // Temporal Binding
  effectiveFrom  DateTime? @map("effective_from")
  effectiveUntil DateTime? @map("effective_until")

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([roleId])
  @@map("permissions")
}

model UserRole {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  userId   String  @map("user_id")
  roleId   String  @map("role_id")
  branchId String? @map("branch_id")

  // Temporal Binding
  effectiveFrom  DateTime? @map("effective_from")
  effectiveUntil DateTime? @map("effective_until")

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([userId])
  @@index([roleId])
  @@index([branchId])
  @@map("user_roles")
}

model BranchAssignment {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  userId   String @map("user_id")
  branchId String @map("branch_id")

  // Temporal Binding
  effectiveFrom  DateTime? @map("effective_from")
  effectiveUntil DateTime? @map("effective_until")

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([userId])
  @@index([branchId])
  // Note: Partial unique index UNIQUE(user_id, branch_id) WHERE is_deleted = false enforced in migration
  @@map("branch_assignments")
}

// ==========================================
// CATALOG MODELS
// ==========================================

// --- Menu (AD-001: current state only; history stored in menu_versions) ---

model Menu {
  id          String     @id @default(uuid())
  tenantId    String     @map("tenant_id")
  name        String
  description String?
  status      MenuStatus @default(DRAFT)

  // Optimistic Concurrency Control (DatabaseSchema.md §14)
  version Int @default(1)

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  menuVersions MenuVersion[]
  menuBranches MenuBranch[]
  categories   Category[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("menus")
}

// AD-001: Separate append-only history table capturing every mutation of a Menu row.
// The menus table always holds current state; menu_versions is the immutable historical log.
model MenuVersion {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  menuId   String @map("menu_id")

  // Snapshot of the menus row at the moment this version was captured
  name        String
  description String?
  status      MenuStatus
  version     Int

  // Timestamp of when this version was recorded
  recordedAt DateTime @default(now()) @map("recorded_at")
  recordedBy String?  @map("recorded_by")

  // Relations
  // No tenant relation needed here to avoid circular back-relation confusion;
  // tenantId is present for isolation per §7.
  menu Menu @relation(fields: [menuId], references: [id], onDelete: Restrict)

  @@index([menuId])
  @@index([tenantId, menuId])
  @@map("menu_versions")
}

// Associative join table: Menu ↔ Branch assignment (many-to-many per §8)
model MenuBranch {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  menuId   String @map("menu_id")
  branchId String @map("branch_id")

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  // Note: Partial unique index UNIQUE(menu_id, branch_id) WHERE is_deleted = false enforced in migration
  @@index([tenantId])
  @@index([menuId])
  @@index([branchId])
  @@map("menu_branches")
}

// --- Category (hierarchical/recursive per §8) ---

model Category {
  id          String         @id @default(uuid())
  tenantId    String         @map("tenant_id")
  menuId      String         @map("menu_id")
  parentId    String?        @map("parent_id")
  name        String
  description String?
  sortOrder   Int            @default(0) @map("sort_order")
  status      CategoryStatus @default(ACTIVE)

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  menu      Menu       @relation(fields: [menuId], references: [id], onDelete: Restrict)
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryHierarchy")
  menuItems MenuItem[]

  @@index([tenantId])
  @@index([menuId])
  @@index([parentId])
  @@map("categories")
}

// --- MenuItem ---

model MenuItem {
  id          String         @id @default(uuid())
  tenantId    String         @map("tenant_id")
  categoryId  String         @map("category_id")
  name        String
  description String?
  price       Decimal        @db.Decimal(10, 2)
  taxRate     Decimal        @default(0) @map("tax_rate") @db.Decimal(5, 4)
  sortOrder   Int            @default(0) @map("sort_order")
  status      MenuItemStatus @default(ACTIVE)

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category               Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  menuItemModifierGroups MenuItemModifierGroup[]
  comboItems             ComboItem[]
  orderItems             OrderItem[]

  @@index([tenantId])
  @@index([categoryId])
  @@index([tenantId, status])
  @@map("menu_items")
}

// --- ModifierGroup (AD-002: two-table model) ---

model ModifierGroup {
  id            String  @id @default(uuid())
  tenantId      String  @map("tenant_id")
  name          String
  minSelections Int     @default(0) @map("min_selections")
  maxSelections Int     @default(1) @map("max_selections")
  isRequired    Boolean @default(false) @map("is_required")

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  modifierOptions        ModifierOption[]
  menuItemModifierGroups MenuItemModifierGroup[]

  @@index([tenantId])
  @@map("modifier_groups")
}

// AD-002: Selectable options within a modifier group.
// Ingredient link intentionally omitted — deferred to Supply Chain bounded context (Phase 7).
model ModifierOption {
  id              String  @id @default(uuid())
  tenantId        String  @map("tenant_id")
  modifierGroupId String  @map("modifier_group_id")
  name            String
  priceDelta      Decimal @default(0) @map("price_delta") @db.Decimal(10, 2)
  sortOrder       Int     @default(0) @map("sort_order")

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant                      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  modifierGroup               ModifierGroup                @relation(fields: [modifierGroupId], references: [id], onDelete: Restrict)
  orderItemModifierSelections OrderItemModifierSelection[]

  @@index([tenantId])
  @@index([modifierGroupId])
  @@map("modifier_options")
}

// AD-003: Associative join table — MenuItem ↔ ModifierGroup (many-to-many per §8).
// Modifier groups are reusable tenant-level resources; this table links them to items.
model MenuItemModifierGroup {
  id              String @id @default(uuid())
  tenantId        String @map("tenant_id")
  menuItemId      String @map("menu_item_id")
  modifierGroupId String @map("modifier_group_id")
  sortOrder       Int    @default(0) @map("sort_order")

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Restrict)

  // Note: Partial unique index UNIQUE(menu_item_id, modifier_group_id) WHERE is_deleted = false enforced in migration
  @@index([tenantId])
  @@index([menuItemId])
  @@index([modifierGroupId])
  @@map("menu_item_modifier_groups")
}

// --- Combo (bundled pricing mechanism per §25.2) ---

model Combo {
  id          String      @id @default(uuid())
  tenantId    String      @map("tenant_id")
  name        String
  description String?
  price       Decimal     @db.Decimal(10, 2)
  taxRate     Decimal     @default(0) @map("tax_rate") @db.Decimal(5, 4)
  status      ComboStatus @default(ACTIVE)

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  comboItems ComboItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("combos")
}

// Associative join table: Combo ↔ MenuItem (many-to-many per §8).
// Combos physically decompose into constituent items for COGS accounting (§25.2).
model ComboItem {
  id         String @id @default(uuid())
  tenantId   String @map("tenant_id")
  comboId    String @map("combo_id")
  menuItemId String @map("menu_item_id")
  quantity   Int    @default(1)
  sortOrder  Int    @default(0) @map("sort_order")

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  combo    Combo    @relation(fields: [comboId], references: [id], onDelete: Restrict)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  // Note: Partial unique index UNIQUE(combo_id, menu_item_id) WHERE is_deleted = false enforced in migration
  @@index([tenantId])
  @@index([comboId])
  @@index([menuItemId])
  @@map("combo_items")
}

// ==========================================
// OPERATIONAL / ORDERING MODELS
// ==========================================

// --- DiningTable (§25.4) ---

model DiningTable {
  id           String      @id @default(uuid())
  tenantId     String      @map("tenant_id")
  branchId     String      @map("branch_id")
  tableNumber  String      @map("table_number")
  capacity     Int         @default(2)
  status       TableStatus @default(AVAILABLE)
  floorSection String?     @map("floor_section")

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  reservations Reservation[]
  orders       Order[]

  // Note: Partial unique index UNIQUE(branch_id, table_number) WHERE is_deleted = false enforced in migration
  @@index([tenantId])
  @@index([branchId])
  @@index([branchId, status])
  @@map("dining_tables")
}

// --- Reservation (§25.4) ---

model Reservation {
  id            String            @id @default(uuid())
  tenantId      String            @map("tenant_id")
  branchId      String            @map("branch_id")
  diningTableId String?           @map("dining_table_id")
  userId        String?           @map("user_id")
  guestName     String            @map("guest_name")
  guestPhone    String?           @map("guest_phone")
  partySize     Int               @map("party_size")
  scheduledAt   DateTime          @map("scheduled_at")
  status        ReservationStatus @default(PENDING)
  notes         String?

  // Overbooking is allowed based on tenant policy threshold (§25.4)
  // Policy enforcement is application-layer; schema records actual bookings.

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  diningTable DiningTable? @relation(fields: [diningTableId], references: [id], onDelete: Restrict)
  user        User?        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([branchId])
  @@index([diningTableId])
  @@index([branchId, scheduledAt])
  @@index([branchId, status])
  @@map("reservations")
}

// --- Order (§25.4, §13, §14 OCC, AD-005 parent-child hierarchy) ---

model Order {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  branchId      String      @map("branch_id")
  diningTableId String?     @map("dining_table_id")
  userId        String?     @map("user_id")
  status        OrderStatus @default(DRAFT)
  orderType     OrderType   @default(DINE_IN) @map("order_type")

  // AD-005: Self-referencing FK for table merge parent-child hierarchy.
  // parentOrderId is null for all standalone and child orders that have no parent.
  // A parent order (created on merge) also has parentOrderId = null; its children point to it.
  parentOrderId String? @map("parent_order_id")

  // Idempotency key for offline POS sync (§13)
  idempotencyKey String @map("idempotency_key")

  // Optimistic Concurrency Control (§14) — clients must pass known version
  version Int @default(1)

  // Financial totals (denormalised for performance; source of truth remains order_items)
  subtotal    Decimal @default(0) @map("subtotal") @db.Decimal(10, 2)
  taxAmount   Decimal @default(0) @map("tax_amount") @db.Decimal(10, 2)
  totalAmount Decimal @default(0) @map("total_amount") @db.Decimal(10, 2)

  notes String?

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  diningTable DiningTable? @relation(fields: [diningTableId], references: [id], onDelete: Restrict)
  user        User?        @relation(fields: [userId], references: [id], onDelete: Restrict)

  // AD-005: Parent-child order hierarchy for table merges
  parentOrder Order?  @relation("OrderMergeHierarchy", fields: [parentOrderId], references: [id], onDelete: Restrict)
  childOrders Order[] @relation("OrderMergeHierarchy")

  // Child records whose lifecycle is dictated by the order (ON DELETE Restrict per §11 for safety)
  orderItems          OrderItem[]
  orderMergesAsParent OrderMerge[]          @relation("ParentOrder")
  orderMergesAsChild  OrderMerge[]          @relation("ChildOrder")
  Customer            Customer?             @relation(fields: [customerId], references: [id])
  customerId          String?
  LoyaltyLedger       LoyaltyLedger[]
  Coupon              Coupon?               @relation(fields: [couponId], references: [id])
  couponId            String?
  CouponCustomerUsage CouponCustomerUsage[]
  GiftCardTransaction GiftCardTransaction[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([branchId])
  @@index([diningTableId])
  @@index([tenantId, branchId, status])
  @@index([tenantId, branchId, status, createdAt])
  @@index([parentOrderId])
  @@map("orders")
}

// AD-005: Associative transaction table recording table merge events per §25.4.
// Records which child orders are grouped under which parent order.
model OrderMerge {
  id            String @id @default(uuid())
  tenantId      String @map("tenant_id")
  parentOrderId String @map("parent_order_id")
  childOrderId  String @map("child_order_id")

  mergedAt   DateTime  @default(now()) @map("merged_at")
  mergedBy   String?   @map("merged_by")
  resolvedAt DateTime? @map("resolved_at")
  resolvedBy String?   @map("resolved_by")

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parentOrder Order  @relation("ParentOrder", fields: [parentOrderId], references: [id], onDelete: Restrict)
  childOrder  Order  @relation("ChildOrder", fields: [childOrderId], references: [id], onDelete: Restrict)

  // Note: Partial unique index UNIQUE(child_order_id) WHERE is_deleted = false enforced in migration
  // (a child order can only belong to one active merge group at a time)
  @@index([tenantId])
  @@index([parentOrderId])
  @@index([childOrderId])
  @@map("order_merges")
}

// --- OrderItem (§25.4, §18 snapshot at creation time) ---

model OrderItem {
  id         String          @id @default(uuid())
  tenantId   String          @map("tenant_id")
  orderId    String          @map("order_id")
  menuItemId String          @map("menu_item_id")
  status     OrderItemStatus @default(PENDING)
  quantity   Int             @default(1)

  // Price snapshot at moment of order creation (§18 — immutable after write)
  unitPrice  Decimal @map("unit_price") @db.Decimal(10, 2)
  taxRate    Decimal @map("tax_rate") @db.Decimal(5, 4)
  totalPrice Decimal @map("total_price") @db.Decimal(10, 2)

  notes String?

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant                      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order                       Order                        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  menuItem                    MenuItem                     @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  orderItemModifierSelections OrderItemModifierSelection[]
  orderItemRecipeSnapshots    OrderItemRecipeSnapshot[]

  @@index([tenantId])
  @@index([orderId])
  @@index([menuItemId])
  @@index([tenantId, status])
  @@map("order_items")
}

// Associative join table: OrderItem ↔ ModifierOption selections (many-to-many per §8).
// Records the exact modifier option chosen and the price delta snapshotted at selection time.
model OrderItemModifierSelection {
  id               String @id @default(uuid())
  tenantId         String @map("tenant_id")
  orderItemId      String @map("order_item_id")
  modifierOptionId String @map("modifier_option_id")

  // Price snapshot at moment of selection (§18 immutability — override may differ from live priceDelta)
  priceDeltaSnapshot Decimal @map("price_delta_snapshot") @db.Decimal(10, 2)

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  orderItem      OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  modifierOption ModifierOption @relation(fields: [modifierOptionId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@index([modifierOptionId])
  @@map("order_item_modifier_selections")
}

// AD-004: Separate relational snapshot table for recipe state at order creation time.
// Append-only after INSERT. One row per ingredient line per order item.
// This table is the authoritative record for COGS, inventory deduction (Phase 7), and financial audit.
// Ingredient FK deferred to Task 1.3 (Supply Chain); ingredientId stored as raw UUID for now.
model OrderItemRecipeSnapshot {
  id          String @id @default(uuid())
  orderItemId String @map("order_item_id")

  // Recipe identity at snapshot time
  recipeId   String? @map("recipe_id")
  recipeName String  @map("recipe_name")

  // Ingredient line captured at order time (ingredient entity belongs to Task 1.3 Supply Chain)
  ingredientId   String  @map("ingredient_id")
  ingredientName String  @map("ingredient_name")
  quantity       Decimal @db.Decimal(10, 4)
  unit           String

  // Yield loss and spoilage factors at snapshot time (§25.3)
  yieldLossPct Decimal @default(0) @map("yield_loss_pct") @db.Decimal(5, 4)
  spoilagePct  Decimal @default(0) @map("spoilage_pct") @db.Decimal(5, 4)

  // Captured timestamp — when this snapshot row was written
  capturedAt DateTime @default(now()) @map("captured_at")

  // Relations
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@index([ingredientId])
  @@map("order_item_recipe_snapshots")
}

// ==========================================
// SUPPLY CHAIN MODELS (Task 1.3)
// ==========================================

// --- Supplier (§25.3) ---
// Can be tenant-wide or branch-specific. Branch FK is nullable for tenant-wide suppliers.
model Supplier {
  id       String         @id @default(uuid())
  tenantId String         @map("tenant_id")
  branchId String?        @map("branch_id")
  name     String
  code     String
  status   SupplierStatus @default(ACTIVE)

  // Contact
  contactName  String? @map("contact_name")
  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")
  address      String?

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  purchaseOrders   PurchaseOrder[]
  supplierInvoices SupplierInvoice[]

  // Note: Partial unique index UNIQUE(tenant_id, code) WHERE is_deleted = false enforced in migration
  @@index([tenantId])
  @@index([branchId])
  @@map("suppliers")
}

// --- Ingredient (§25.3) ---
// Master ingredient catalog. Central (tenant-level).
// This model closes the forward-reference from order_item_recipe_snapshots.ingredient_id.
model Ingredient {
  id       String         @id @default(uuid())
  tenantId String         @map("tenant_id")
  name     String
  unit     IngredientUnit @default(KG)

  // Base unit cost for COGS calculations
  unitCost Decimal @default(0) @map("unit_cost") @db.Decimal(10, 4)

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  inventoryItems    InventoryItem[]
  recipeIngredients RecipeIngredient[]
  inventoryBatches  InventoryBatch[]
  stockMovements    StockMovement[]
  goodsReceiptItems GoodsReceiptItem[]

  @@index([tenantId])
  @@map("ingredients")
}

// --- InventoryItem (§25.3) ---
// Branch-level stock tracking. OCC applied (§14) — high-contention entity.
model InventoryItem {
  id           String @id @default(uuid())
  tenantId     String @map("tenant_id")
  branchId     String @map("branch_id")
  ingredientId String @map("ingredient_id")

  // Theoretical stock (from recipe deductions) vs actual (physical count)
  theoreticalQty Decimal  @default(0) @map("theoretical_qty") @db.Decimal(10, 4)
  actualQty      Decimal  @default(0) @map("actual_qty") @db.Decimal(10, 4)
  reorderLevel   Decimal? @map("reorder_level") @db.Decimal(10, 4)
  reorderQty     Decimal? @map("reorder_qty") @db.Decimal(10, 4)

  // OCC (§14)
  version Int @default(1)

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  // Note: Partial unique index UNIQUE(branch_id, ingredient_id) WHERE is_deleted = false enforced in migration
  @@index([tenantId])
  @@index([branchId])
  @@index([ingredientId])
  @@map("inventory_items")
}

// --- InventoryBatch (§25.3 FIFO/FEFO) ---
// Physical batch tracking for FIFO/FEFO depletion. Immutable once received_qty is set.
model InventoryBatch {
  id           String @id @default(uuid())
  tenantId     String @map("tenant_id")
  branchId     String @map("branch_id")
  ingredientId String @map("ingredient_id")

  batchNumber  String    @map("batch_number")
  receivedQty  Decimal   @map("received_qty") @db.Decimal(10, 4)
  remainingQty Decimal   @map("remaining_qty") @db.Decimal(10, 4)
  unitCost     Decimal   @map("unit_cost") @db.Decimal(10, 4)
  expiresAt    DateTime? @map("expires_at")
  receivedAt   DateTime  @default(now()) @map("received_at")

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([branchId])
  @@index([ingredientId])
  @@index([branchId, ingredientId, expiresAt])
  @@map("inventory_batches")
}

// --- StockMovement (§25.3 — immutable per §3) ---
// Every stock change is a permanent append-only record.
// No soft delete columns — this is an immutable audit ledger.
model StockMovement {
  id           String            @id @default(uuid())
  tenantId     String            @map("tenant_id")
  branchId     String            @map("branch_id")
  ingredientId String            @map("ingredient_id")
  movementType StockMovementType @map("movement_type")

  quantityDelta Decimal @map("quantity_delta") @db.Decimal(10, 4)
  unitCost      Decimal @map("unit_cost") @db.Decimal(10, 4)

  // Source of movement (order, GRN, manual adjustment, etc.)
  referenceId   String? @map("reference_id")
  referenceType String? @map("reference_type")
  notes         String?

  // Audit Fields — no updatedBy; record is immutable after insert
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  // Relations
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([branchId])
  @@index([ingredientId])
  @@index([branchId, ingredientId, createdAt])
  @@map("stock_movements")
}

// --- Recipe (§25.3) ---
// Central transformation matrix. OCC applied (§14).
model Recipe {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  menuItemId  String? @map("menu_item_id")
  name        String
  description String?

  // OCC (§14)
  version Int @default(1)

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  recipeIngredients RecipeIngredient[]

  @@index([tenantId])
  @@index([menuItemId])
  @@map("recipes")
}

// --- RecipeIngredient (§25.3) ---
// Associative join table: Recipe ↔ Ingredient.
// Optional branchId enables branch-level ingredient substitutions per documented rule (§25.3).
model RecipeIngredient {
  id           String  @id @default(uuid())
  tenantId     String  @map("tenant_id")
  recipeId     String  @map("recipe_id")
  ingredientId String  @map("ingredient_id")
  branchId     String? @map("branch_id")

  // Transformation factors (§25.3)
  quantity     Decimal        @db.Decimal(10, 4)
  unit         IngredientUnit
  yieldLossPct Decimal        @default(0) @map("yield_loss_pct") @db.Decimal(5, 4)
  spoilagePct  Decimal        @default(0) @map("spoilage_pct") @db.Decimal(5, 4)

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  // Note: Partial unique index UNIQUE(recipe_id, ingredient_id, branch_id) WHERE is_deleted = false enforced in migration
  @@index([tenantId])
  @@index([recipeId])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}

// --- PurchaseOrder (§25.3 Three-Way Match) ---
model PurchaseOrder {
  id         String              @id @default(uuid())
  tenantId   String              @map("tenant_id")
  branchId   String              @map("branch_id")
  supplierId String              @map("supplier_id")
  status     PurchaseOrderStatus @default(DRAFT)
  poNumber   String              @map("po_number")

  subtotal   Decimal   @default(0) @db.Decimal(10, 2)
  taxAmount  Decimal   @default(0) @map("tax_amount") @db.Decimal(10, 2)
  total      Decimal   @default(0) @db.Decimal(10, 2)
  orderedAt  DateTime? @map("ordered_at")
  expectedAt DateTime? @map("expected_at")
  notes      String?

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch             Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier           Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceipts      GoodsReceipt[]
  supplierInvoice    SupplierInvoice?

  // Note: Partial unique index UNIQUE(tenant_id, po_number) WHERE is_deleted = false enforced in migration
  @@index([tenantId])
  @@index([branchId])
  @@index([supplierId])
  @@index([tenantId, status])
  @@map("purchase_orders")
}

// Constituent line items of a Purchase Order
model PurchaseOrderItem {
  id              String         @id @default(uuid())
  tenantId        String         @map("tenant_id")
  purchaseOrderId String         @map("purchase_order_id")
  ingredientId    String         @map("ingredient_id")
  orderedQty      Decimal        @map("ordered_qty") @db.Decimal(10, 4)
  unit            IngredientUnit
  unitCost        Decimal        @map("unit_cost") @db.Decimal(10, 4)
  totalCost       Decimal        @map("total_cost") @db.Decimal(10, 2)

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

// --- GoodsReceipt (§25.3 Three-Way Match) ---
model GoodsReceipt {
  id              String             @id @default(uuid())
  tenantId        String             @map("tenant_id")
  branchId        String             @map("branch_id")
  purchaseOrderId String             @map("purchase_order_id")
  status          GoodsReceiptStatus @default(PENDING)
  grnNumber       String             @map("grn_number")
  receivedAt      DateTime           @default(now()) @map("received_at")
  notes           String?

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch            Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  purchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  goodsReceiptItems GoodsReceiptItem[]

  @@index([tenantId])
  @@index([branchId])
  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

// Constituent line items of a Goods Receipt (Three-Way Match line level)
model GoodsReceiptItem {
  id             String         @id @default(uuid())
  tenantId       String         @map("tenant_id")
  goodsReceiptId String         @map("goods_receipt_id")
  ingredientId   String         @map("ingredient_id")
  receivedQty    Decimal        @map("received_qty") @db.Decimal(10, 4)
  acceptedQty    Decimal        @map("accepted_qty") @db.Decimal(10, 4)
  rejectedQty    Decimal        @default(0) @map("rejected_qty") @db.Decimal(10, 4)
  unit           IngredientUnit
  unitCost       Decimal        @map("unit_cost") @db.Decimal(10, 4)
  notes          String?

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)
  ingredient   Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([goodsReceiptId])
  @@index([ingredientId])
  @@map("goods_receipt_items")
}

// ==========================================
// FINANCE MODELS (Task 1.3)
// ==========================================

// --- LedgerAccount (§25.6 Chart of Accounts — hierarchical) ---
model LedgerAccount {
  id       String            @id @default(uuid())
  tenantId String            @map("tenant_id")
  parentId String?           @map("parent_id")
  code     String
  name     String
  type     LedgerAccountType

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parent         LedgerAccount?  @relation("LedgerAccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children       LedgerAccount[] @relation("LedgerAccountHierarchy")
  journalEntries JournalEntry[]

  // Note: Partial unique index UNIQUE(tenant_id, code) WHERE is_deleted = false enforced in migration
  @@index([tenantId])
  @@index([parentId])
  @@map("ledger_accounts")
}

// --- Shift (§25.6) ---
// Operational session boundary. A Branch cannot sell without an open Shift.
model Shift {
  id       String      @id @default(uuid())
  tenantId String      @map("tenant_id")
  branchId String      @map("branch_id")
  userId   String      @map("user_id")
  status   ShiftStatus @default(OPEN)

  openedAt     DateTime  @default(now()) @map("opened_at")
  closedAt     DateTime? @map("closed_at")
  openingFloat Decimal   @default(0) @map("opening_float") @db.Decimal(10, 2)
  closingFloat Decimal?  @map("closing_float") @db.Decimal(10, 2)

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  cashDrawers CashDrawer[]
  journals    Journal[]

  @@index([tenantId])
  @@index([branchId])
  @@index([branchId, status])
  @@map("shifts")
}

// --- CashDrawer (§25.6) ---
// Physical till associated with a Shift.
model CashDrawer {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  branchId String @map("branch_id")
  shiftId  String @map("shift_id")
  name     String

  openingBalance Decimal  @default(0) @map("opening_balance") @db.Decimal(10, 2)
  closingBalance Decimal? @map("closing_balance") @db.Decimal(10, 2)
  isOpen         Boolean  @default(true) @map("is_open")

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  shift  Shift  @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([branchId])
  @@index([shiftId])
  @@map("cash_drawers")
}

// --- DailyClosing (§25.6) ---
// Period-end reconciliation snapshot. Status LOCKED enforces immutability (§3).
// Reopening a LOCKED day requires elevated Controller permissions (§25.6).
model DailyClosing {
  id          String             @id @default(uuid())
  tenantId    String             @map("tenant_id")
  branchId    String             @map("branch_id")
  closingDate DateTime           @map("closing_date") @db.Date
  status      DailyClosingStatus @default(PENDING)

  expectedCash Decimal @default(0) @map("expected_cash") @db.Decimal(10, 2)
  actualCash   Decimal @default(0) @map("actual_cash") @db.Decimal(10, 2)
  variance     Decimal @default(0) @db.Decimal(10, 2)
  totalRevenue Decimal @default(0) @map("total_revenue") @db.Decimal(10, 2)
  notes        String?

  lockedAt DateTime? @map("locked_at")
  lockedBy String?   @map("locked_by")

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete (§17 — status LOCKED is the immutability gate; soft delete also protected)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  // Note: Partial unique index UNIQUE(branch_id, closing_date) WHERE is_deleted = false enforced in migration
  @@index([tenantId])
  @@index([branchId])
  @@index([branchId, closingDate])
  @@map("daily_closings")
}

// --- Invoice (§25.6 — immutable once status = PAID per §3) ---
model Invoice {
  id       String        @id @default(uuid())
  tenantId String        @map("tenant_id")
  branchId String        @map("branch_id")
  orderId  String        @map("order_id")
  status   InvoiceStatus @default(DRAFT)

  // Immutable after PAID (§3)
  subtotal  Decimal @default(0) @db.Decimal(10, 2)
  taxAmount Decimal @default(0) @map("tax_amount") @db.Decimal(10, 2)
  total     Decimal @default(0) @db.Decimal(10, 2)

  issuedAt DateTime? @map("issued_at")
  dueAt    DateTime? @map("due_at")
  notes    String?

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch     Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  payments   Payment[]
  refunds    Refund[]
  Customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?

  @@index([tenantId])
  @@index([branchId])
  @@index([orderId])
  @@index([tenantId, status])
  @@map("invoices")
}

// --- Payment (§25.6 — state machine: Initiated → Authorized → Captured) ---
model Payment {
  id        String        @id @default(uuid())
  tenantId  String        @map("tenant_id")
  invoiceId String        @map("invoice_id")
  status    PaymentStatus @default(INITIATED)
  method    PaymentMethod

  amount        Decimal @db.Decimal(10, 2)
  referenceCode String? @map("reference_code")

  giftCardId          String?               @map("gift_card_id")
  GiftCard            GiftCard?             @relation(fields: [giftCardId], references: [id])
  GiftCardTransaction GiftCardTransaction[]

  // Gateway response stored as JSONB (do NOT log sensitive PAN/CVV per §20)
  gatewayPayload Json? @map("gateway_payload")

  // Idempotency key for gateway retries (§13)
  idempotencyKey String @map("idempotency_key")

  capturedAt DateTime? @map("captured_at")
  notes      String?

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  refunds Refund[]
  Tenant  Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([invoiceId])
  @@index([tenantId, status])
  @@map("payments")
}

// --- Refund (§25.6 — counter-transaction per §3; never mutates Payment) ---
// Each refund is a new, distinct financial record. Corrections via counter-journals (§25.6).
model Refund {
  id        String       @id @default(uuid())
  tenantId  String       @map("tenant_id")
  invoiceId String       @map("invoice_id")
  paymentId String       @map("payment_id")
  status    RefundStatus @default(PENDING)

  amount Decimal @db.Decimal(10, 2)
  reason String
  notes  String?

  // Elevated permission required for closed-period refunds (§25.6)
  approvedBy String?   @map("approved_by")
  approvedAt DateTime? @map("approved_at")

  // Idempotency key (§13)
  idempotencyKey String @map("idempotency_key")

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  Tenant  Tenant  @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([invoiceId])
  @@index([paymentId])
  @@map("refunds")
}

// --- Journal (§25.6 Double-Entry Accounting) ---
// Immutable once posted. Corrections via counter-journals only (§25.6).
model Journal {
  id            String  @id @default(uuid())
  tenantId      String  @map("tenant_id")
  shiftId       String? @map("shift_id")
  description   String
  referenceId   String? @map("reference_id")
  referenceType String? @map("reference_type")

  isPosted Boolean   @default(false) @map("is_posted")
  postedAt DateTime? @map("posted_at")

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete (only permitted before posting)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  shift          Shift?         @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  journalEntries JournalEntry[]

  @@index([tenantId])
  @@index([shiftId])
  @@index([tenantId, isPosted])
  @@map("journals")
}

// --- JournalEntry (§25.6 — individual debit/credit lines; immutable once journal is posted) ---
model JournalEntry {
  id              String           @id @default(uuid())
  tenantId        String           @map("tenant_id")
  journalId       String           @map("journal_id")
  ledgerAccountId String           @map("ledger_account_id")
  entryType       JournalEntryType @map("entry_type")
  amount          Decimal          @db.Decimal(10, 2)
  description     String?

  // Audit Fields — no updatedBy; lines are immutable once journal is posted
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  // Relations
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  journal       Journal       @relation(fields: [journalId], references: [id], onDelete: Restrict)
  ledgerAccount LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([journalId])
  @@index([ledgerAccountId])
  @@map("journal_entries")
}

// ==========================================
// AUDIT LOG MODEL (Task 1.4)
// ==========================================

// --- AuditLog (§25.8, §16, CodingStandards §12) ---
// Tamper-evident, append-only record of critical actions.
// Written synchronously within the triggering transaction (CodingStandards §12).
// Physical DELETE strictly prohibited (§3, §17). No soft delete columns — immutable by design.
// Actions audited include: Voids, Config changes, Reopening closed shifts, Permission grants, Day Close.
model AuditLog {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  // Actor — nullable for system-generated events (e.g., scheduled workers)
  userId String? @map("user_id")

  // Audited entity reference (polymorphic — entity type + entity id)
  entityType String @map("entity_type")
  entityId   String @map("entity_id")

  // Action performed (e.g., ORDER_VOIDED, SHIFT_REOPENED, CONFIG_CHANGED)
  action String

  // Before/after state captured as JSONB for full mutation traceability (§16)
  // Only fields that changed are captured; omitted if not applicable (e.g., DELETE equivalent).
  beforeState Json? @map("before_state")
  afterState  Json? @map("after_state")

  // Reason/justification — mandatory for high-sensitivity actions (Voids, Reopening)
  reason String?

  // Metadata for distributed tracing and forensic correlation
  ipAddress     String? @map("ip_address")
  userAgent     String? @map("user_agent")
  correlationId String? @map("correlation_id")

  // Immutable timestamp — records when the audit event was written
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Composite indexes for common forensic and compliance query patterns (§22)
  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([tenantId, action, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

// ==========================================
// CONFIGURATION MODEL (Task 1.4 Foundation Patch)
// ==========================================

// --- Configuration (§25.8) ---
// JSONB-based resolution of cascading rules (Global -> Tenant -> Branch -> Station).
model Configuration {
  id    String             @id @default(uuid())
  level ConfigurationLevel
  key   String
  value Json               @map("value")

  tenantId  String? @map("tenant_id")
  branchId  String? @map("branch_id")
  stationId String? @map("station_id") // Loose reference

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  // Ensure uniqueness for a key at a specific scope
  @@unique([key, level, tenantId, branchId, stationId])
  @@index([tenantId])
  @@index([branchId])
  @@map("configurations")
}

model FiscalPeriod {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  name      String
  startDate DateTime  @map("start_date")
  endDate   DateTime  @map("end_date")
  isClosed  Boolean   @default(false) @map("is_closed")
  closedAt  DateTime? @map("closed_at")
  closedBy  String?   @map("closed_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isDeleted Boolean  @default(false) @map("is_deleted")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([startDate, endDate])
  @@map("fiscal_periods")
}

model CostCenter {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  branchId    String? @map("branch_id")
  code        String
  name        String
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isDeleted Boolean  @default(false) @map("is_deleted")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([branchId])
  @@map("cost_centers")
}

model SupplierInvoice {
  id              String        @id @default(uuid())
  tenantId        String        @map("tenant_id")
  branchId        String        @map("branch_id")
  supplierId      String        @map("supplier_id")
  purchaseOrderId String?       @unique @map("purchase_order_id")
  invoiceNumber   String        @map("invoice_number")
  invoiceDate     DateTime      @map("invoice_date")
  dueDate         DateTime?     @map("due_date")
  totalAmount     Decimal       @map("total_amount")
  taxAmount       Decimal       @default(0) @map("tax_amount")
  status          InvoiceStatus @default(ISSUED)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  isDeleted Boolean  @default(false) @map("is_deleted")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier      Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([branchId])
  @@index([supplierId])
  @@map("supplier_invoices")
}

// ==========================================
// CRM MODELS
// ==========================================

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  BOGO
}

enum CouponStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum GiftCardStatus {
  ACTIVE
  EXPIRED
  DEPLETED
  BLOCKED
}

enum GiftCardTransactionType {
  ACTIVATION
  REDEMPTION
  REFUND
  ADJUSTMENT
}

enum LoyaltyTransactionType {
  EARNED
  REDEEMED
  EXPIRED
  ADJUSTED
}

enum MembershipTier {
  BASIC
  SILVER
  GOLD
  PLATINUM
}

model Customer {
  id        String         @id @default(uuid())
  tenantId  String         @map("tenant_id")
  firstName String         @map("first_name")
  lastName  String         @map("last_name")
  email     String?
  phone     String?
  status    CustomerStatus @default(ACTIVE)

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships    Membership[]
  loyaltyLedgers LoyaltyLedger[]
  orders         Order[]
  invoices       Invoice[]
  couponUsages   CouponCustomerUsage[]
  giftCards      GiftCard[]

  @@index([tenantId])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@map("customers")
}

model Membership {
  id         String         @id @default(uuid())
  tenantId   String         @map("tenant_id")
  customerId String         @map("customer_id")
  tier       MembershipTier @default(BASIC)

  joinedAt  DateTime  @default(now()) @map("joined_at")
  expiresAt DateTime? @map("expires_at")

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([customerId])
  @@map("memberships")
}

model LoyaltyLedger {
  id         String  @id @default(uuid())
  tenantId   String  @map("tenant_id")
  customerId String  @map("customer_id")
  orderId    String? @map("order_id")

  points Int
  type   LoyaltyTransactionType
  reason String?

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([customerId])
  @@map("loyalty_ledgers")
}

model Coupon {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  code          String
  type          CouponType
  value         Decimal      @db.Decimal(10, 2)
  minOrderValue Decimal?     @map("min_order_value") @db.Decimal(10, 2)
  status        CouponStatus @default(ACTIVE)

  validFrom   DateTime? @map("valid_from")
  validUntil  DateTime? @map("valid_until")
  maxUses     Int?      @map("max_uses")
  currentUses Int       @default(0) @map("current_uses")

  maxDiscountValue   Decimal? @map("max_discount_value") @db.Decimal(10, 2)
  isStackable        Boolean  @default(false) @map("is_stackable")
  maxUsesPerCustomer Int?     @map("max_uses_per_customer")

  applicableCategoryIds String[] @default([]) @map("applicable_category_ids")
  applicableItemIds     String[] @default([]) @map("applicable_item_ids")

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  tenant Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orders Order[]
  usages CouponCustomerUsage[]

  @@index([tenantId])
  @@index([tenantId, code])
  @@map("coupons")
}

model CouponCustomerUsage {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  couponId   String   @map("coupon_id")
  customerId String   @map("customer_id")
  orderId    String   @map("order_id")
  usedAt     DateTime @default(now()) @map("used_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([couponId, customerId])
  @@map("coupon_customer_usages")
}

model GiftCard {
  id             String         @id @default(uuid())
  tenantId       String         @map("tenant_id")
  code           String
  initialValue   Decimal        @map("initial_value") @db.Decimal(10, 2)
  currentBalance Decimal        @map("current_balance") @db.Decimal(10, 2)
  status         GiftCardStatus @default(ACTIVE)

  expiresAt DateTime? @map("expires_at")

  // Audit Fields
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Soft Delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  customerId String? @map("customer_id")

  // Relations
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer     Customer?             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  transactions GiftCardTransaction[]
  payments     Payment[]

  @@index([tenantId])
  @@index([tenantId, code])
  @@index([customerId])
  @@map("gift_cards")
}

model GiftCardTransaction {
  id           String                  @id @default(uuid())
  tenantId     String                  @map("tenant_id")
  giftCardId   String                  @map("gift_card_id")
  orderId      String?                 @map("order_id")
  paymentId    String?                 @map("payment_id")
  type         GiftCardTransactionType
  amount       Decimal                 @db.Decimal(10, 2)
  balanceAfter Decimal                 @map("balance_after") @db.Decimal(10, 2)
  notes        String?

  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  giftCard GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Restrict)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment  Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([giftCardId])
  @@index([orderId])
  @@map("gift_card_transactions")
}

// ==========================================
// ANALYTICS SNAPSHOTS (Phase 10)
// ==========================================

enum AnalyticsSnapshotType {
  PMIX
  LABOR_TO_SALES
}

model AnalyticsSnapshot {
  id       String                @id @default(uuid())
  tenantId String                @map("tenant_id")
  branchId String?               @map("branch_id")
  type     AnalyticsSnapshotType
  data     Json

  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")

  capturedAt DateTime @default(now()) @map("captured_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, type, periodStart])
  @@map("analytics_snapshots")
}
